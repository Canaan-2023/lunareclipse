{
  "name": "lunareclipse",
  "version": "0.53.10",
  "description": "LunarEclipse - ABYSSAC memory system agent",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/e2e-*.test.ts",
    "test:coverage": "vitest run --coverage --exclude test/e2e-*.test.ts",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "lock:mirror": "node scripts/sync-mirror-lock.mjs",
    "eval": "node scripts/run-eval.mjs",
    "eval:regression": "node scripts/run-eval.mjs --suite=dmn-regression --gate=0.95",
    "eval:quality": "node scripts/run-eval.mjs --suite=frontend-ai-baseline --gate=0.3"
  },
  "author": "ABYSSAC",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Canaan-2023/lunareclipse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canaan-2023/lunareclipse.git"
  },
  "bugs": {
    "url": "https://github.com/Canaan-2023/lunareclipse/issues"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@parcel/watcher": "^2.6.0",
    "@xmldom/xmldom": "^0.9.12",
    "async-mutex": "^0.5.0",
    "express": "^5.2.1",
    "ink": "^8.0.0",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "openai": "^7.22.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "wrap-ansi": "^10.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
